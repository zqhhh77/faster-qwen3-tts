# 配合 compose.m5.yaml 和 compose.m5.cuda.yaml 使用，模型保留 FP32。
M5_MODEL_HOST_DIR=./.cache/M5-TTS-50M-ONNX-fp32-pair
M5_DEVICE=cuda
# 宿主机 GPU 编号；容器只暴露这一张卡，内部编号固定为 0。
M5_CUDA_VISIBLE_DEVICE=0
# 两路独立音色状态共享 GPU 模型 Session。
M5_WORKERS=2
M5_THREADS=2
M5_CUDA_GRAPH=on
# CUDA Graph 使用单请求深度图，保持合批关闭。
M5_DEPTH_BATCH=off
M5_MAX_FRAMES=1024
M5_ALERT_PHRASES=off
M5_ALERT_SHIP_PARTS=off
M5_ALERT_FIELD_CACHE_MB=0
M5_ALERT_CACHE_HOST_DIR=./cache/m5-alerts
M5_DEFAULT_VOICE=default
M5_VOICES_FILE=/app/backend/m5/voices.json
# 自定义音色：将录音和 voices.json 放在 references/m5，改用下行。
# M5_VOICES_FILE=/references/m5/voices.json
TTS_IMAGE_PREFIX=tts
TTS_IMAGE_TAG=latest
TTS_BIND_ADDRESS=127.0.0.1
TTS_PORT=8000
TTS_CACHE_HOST_DIR=./cache
TTS_CACHE_MAX_MB=256
TTS_CACHE_TTL_SECONDS=300
TTS_TASK_TIMEOUT_SECONDS=120
