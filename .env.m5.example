# M5 CPU 双路流式部署。首次使用按 docs/m5.md 准备 INT8 模型目录。
M5_MODEL_HOST_DIR=./models/M5-TTS-50M-ONNX-depth-int8
M5_DEVICE=cpu
M5_DEVICE_ID=0
M5_THREADS=3
M5_WORKERS=2
# FP32 双请求深度合批，需要 --depth-pair 准备模型，并使用两个实例。
M5_DEPTH_BATCH=off
M5_MAX_FRAMES=1024
# 按音色预生成四个固定短语并保存到磁盘，重启直接复用。
M5_ALERT_PHRASES=on
# 固定短语和动态字段的宿主机磁盘目录。
M5_ALERT_CACHE_HOST_DIR=./cache/m5-alerts
# 船名、区域和告警类型的磁盘缓存总量（MiB），0 关闭动态缓存，固定短语仍落盘。
M5_ALERT_FIELD_CACHE_MB=0
# 可选：拆分并缓存船名前缀，需要动态字段缓存大于 0。
M5_ALERT_SHIP_PARTS=off
# 编号末尾约 240 ms 的播放速度：0.65 适度延长，0.5 更长，1 保持原速。
M5_ALERT_NUMBER_TAIL_SPEED=0.65
M5_DEFAULT_VOICE=default
# Built-in demo voice. For your own voices use /references/m5/voices.json.
M5_VOICES_FILE=/app/backend/m5/voices.json

# For published images: ghcr.io/zqhhh77/faster-qwen3-tts
TTS_IMAGE_PREFIX=tts
# Published pairs use sha-<full commit SHA>; local builds can use latest.
TTS_IMAGE_TAG=latest
TTS_BIND_ADDRESS=127.0.0.1
TTS_PORT=8000
TTS_CACHE_HOST_DIR=./cache
TTS_CACHE_MAX_MB=256
TTS_CACHE_TTL_SECONDS=300
TTS_MAX_PENDING_TASKS=8
TTS_MAX_READERS=256
TTS_TASK_TIMEOUT_SECONDS=120
TTS_SEND_TIMEOUT_SECONDS=15
TTS_CACHE_CLEANUP_SECONDS=5
