FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg socat \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/edge/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/edge/server.py backend/edge/
COPY backend/m5/generated/ backend/m5/generated/
ENV PYTHONUNBUFFERED=1
EXPOSE 50051
ENTRYPOINT ["python", "-m", "backend.edge.server"]
