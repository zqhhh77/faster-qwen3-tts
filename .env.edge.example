# 宿主机上的音色映射文件。可从 references/edge-voices.example.json 复制。
EDGE_TTS_VOICES_FILE=./references/edge-voices.json

# 使用 GHCR 发布的 Edge 和 Gateway 配套镜像。
TTS_IMAGE_TAG=edge

# 叠加 compose.edge.moto.yaml 时默认使用 115.28.184.80:9010，按需覆盖。
# EDGE_TTS_MOTO_ADDR=115.28.184.80:9010

# Gateway 默认只监听本机。按需填写服务器的内网 IP。
# TTS_BIND_ADDRESS=127.0.0.1
# TTS_PORT=8000

# 合成并发数。
# EDGE_TTS_WORKERS=4
